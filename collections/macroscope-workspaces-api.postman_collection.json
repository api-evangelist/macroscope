        {
          "id": "ab3237a0-87ab-4701-8d58-33c198c64c93",
          "name": "Poll for an agent job result",
          "request": {
            "name": "Poll for an agent job result",
            "description": {
              "content": "Poll for the result of a triggered job. Send the jobToken returned by the trigger as an Authorization: Bearer header. While running the response carries a Retry-After header (seconds). The job token is valid for about one hour.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "workspaces",
                ":workspaceType",
                ":workspaceId",
                "query-agent-jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceType",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
